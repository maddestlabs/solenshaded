# SolEnshaded Deck Recipe — Classic Victorian

sol.set_theme({
    id: "classic",
    name: "Classic Victorian",
    author: "Public Domain CC0",
    description: "Lossless Deflate-compressed SVG vector master sheet.",
    version: 1
})

deck_blob = """"""

sol.set_deck(deck_blob, {
    format: "svgz",
    card_w: 360,
    card_h: 504,
    theme_id: "classic"
})
