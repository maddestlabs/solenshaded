# SolEnshaded Deck Recipe — Vintage Intaglio (Hand-Sketched Engraving)
# 100% procedural card deck generated via Eatscript without bitmaps.
# Demonstrates vintage copperplate engraving, hand-sketched ink bleed, 
# cotton rag paper grain, and classical symmetrical cartouches.

sol.set_theme({
    id: "engraved_intaglio",
    name: "Vintage Intaglio (Hand-Sketched)",
    author: "SolEnshaded Procedural Engine",
    description: "Classical copperplate engraved deck on warm cotton rag paper with hand-drawn quill ink aesthetic.",
    version: 2,
    corner_radius: 6.0
})

def on_draw_card_face(ctx, rank, suit, w, h):
    # 1. Warm antique cotton rag paper background
    paper_bg    = "#f6f1e5"
    ink_black   = "#1a1815"
    ink_crimson = "#9e1b27"
    sepia_line  = "#6e5d4a"

    is_red = (suit == "hearts" or suit == "diamonds")
    pip_color = ink_black
    if is_red:
        pip_color = ink_crimson

    cx = w * 0.5
    cy = h * 0.5
    is_court = (rank == "J" or rank == "Q" or rank == "K")
    is_ace   = (rank == "A")

    # 2. Card plate with hand-drawn etched borders
    ctx.fill_rounded_rect(0, 0, w, h, 6.0, paper_bg)
    ctx.stroke_rounded_rect(0, 0, w, h, 6.0, ink_black, 1.3)
    ctx.stroke_rounded_rect(3.5, 3.5, w - 7.0, h - 7.0, 4.2, sepia_line, 0.7)
    ctx.stroke_rounded_rect(5.5, 5.5, w - 11.0, h - 11.0, 3.5, ink_black, 0.5)

    # 3. Symmetrical Engraved Corner Flourishes
    corner_size = 36.0
    if is_ace or is_court:
        corner_size = 48.0

    ctx.begin_symmetry(mirror_x=True, mirror_y=True)
    ctx.draw_baroque_corner(22.0, 22.0, corner_size, ink_black, sepia_line)
    ctx.end_symmetry()

    # 4. Beaded pearl trim along frame
    ctx.repeat_beads(inset=13.0, radius=2.2, spacing=7.5, color=sepia_line)

    # 5. Central Presentation based on Card Type
    if is_ace:
        rx = w * 0.38
        ry = h * 0.34
        ctx.draw_baroque_cartouche(cx, cy, rx, ry, ink_black, sepia_line, 2.2)
        ctx.draw_baroque_crest(cx, cy - ry * 1.02, 1.0, ink_black, sepia_line, False)
        ctx.draw_baroque_crest(cx, cy + ry * 1.02, 1.0, ink_black, sepia_line, True)

        if suit == "spades":
            ctx.draw_baroque_spade(cx, cy, w * 0.44, pip_color, paper_bg, sepia_line)
        else:
            ctx.draw_ornate_suit(suit, cx=cx, cy=cy, size=w * 0.36, body_color=pip_color, filigree_color=paper_bg)

    elif is_court:
        margin_x = w * 0.19
        margin_y = h * 0.17
        inner_w  = w - margin_x * 2.0
        inner_h  = h - margin_y * 2.0
        ctx.draw_court(rank, suit, margin_x, margin_y, inner_w, inner_h, 0.95, ink_black)

    else:
        # Number cards: delicate copperplate cartouche hairline allowing pips to breathe
        rx = w * 0.34
        ry = h * 0.29
        ctx.stroke_cartouche(cx, cy, rx=rx, ry=ry, style="baroque_oval", color=sepia_line, line_width=1.0)
        ctx.draw_pip_layout(rank, suit, w, h, color=pip_color)

    # 6. Corner Indices (+3px vertical padding)
    ctx.draw_corner_indices(rank, suit, w, h, color=pip_color, font_size=24.0)

    # 7. Apply Hand-Sketched / Intaglio Engraving Finish
    ctx.apply_finish(
        style="hand_sketched",
        paper_grain=0.18,
        ink_bleed=0.22
    )

def on_draw_card_back(ctx, w, h):
    paper_bg   = "#f6f1e5"
    ink_black  = "#1a1815"
    sepia_line = "#6e5d4a"

    cx = w * 0.5
    cy = h * 0.5

    ctx.fill_rounded_rect(0, 0, w, h, 6.0, paper_bg)
    ctx.stroke_rounded_rect(0, 0, w, h, 6.0, ink_black, 1.4)
    ctx.stroke_rounded_rect(4.0, 4.0, w - 8.0, h - 8.0, 4.0, sepia_line, 0.8)

    # Intaglio all-over mirror engraving
    ctx.begin_symmetry(mirror_x=True, mirror_y=True)
    ctx.draw_baroque_corner(22.0, 22.0, 52.0, ink_black, sepia_line)
    ctx.draw_acanthus(from=[22.0, 92.0], to=[22.0, 168.0], lobes=4, curl_dir="right", color=paper_bg, stroke=ink_black, stroke_width=1.0)
    ctx.draw_volute(cx=cx - 34.0, cy=cy - 34.0, radius=28.0, turns=1.1, angle_start=0.4, color=sepia_line, width=1.6, profile="chisel")
    ctx.end_symmetry()

    ctx.repeat_beads(inset=12.0, radius=2.2, spacing=7.5, color=ink_black)

    # Center etched cartouche
    rx = w * 0.32
    ry = h * 0.27
    ctx.draw_baroque_cartouche(cx, cy, rx, ry, ink_black, sepia_line, 2.4)
    ctx.draw_baroque_crest(cx, cy - ry * 1.02, 1.0, ink_black, sepia_line, False)
    ctx.draw_baroque_crest(cx, cy + ry * 1.02, 1.0, ink_black, sepia_line, True)

    ctx.fill_oval(cx, cy, rx=w * 0.22, ry=h * 0.17, color="#ebe5d6")
    ctx.draw_baroque_spade(cx, cy, size=w * 0.25, body_color=ink_black, filigree_color=paper_bg, accent_color=sepia_line)

    ctx.apply_finish(
        style="hand_sketched",
        paper_grain=0.20,
        ink_bleed=0.25
    )
